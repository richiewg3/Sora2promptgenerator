# ── AI Provider (pick ONE) ───────────────────────────────────────────
# Option 1: Vercel AI Gateway (preferred for Vercel deployments)
# AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key

# Option 2: OpenAI direct
# OPENAI_API_KEY=sk-your_openai_api_key

# ── Optional: model override ────────────────────────────────────────
# If not set, the app auto-detects the best available model.
# Gateway examples: openai/gpt-5, openai/gpt-4o
# OpenAI  examples: gpt-5.2, gpt-4o
# AI_MODEL=openai/gpt-4o
